#!/usr/bin/env bash
# local-claude — wrapper to run Claude Code with local LLMs
# Usage: local-claude [--backend lmstudio|llama] [claude arguments...]
#
# Backends:
#   lmstudio  — connects to a running LM Studio server (default port 1234)
#   llama     — starts llama-server with an interactively chosen GGUF model
#
# Environment variables:
#   LCC_HOST      — LM Studio host (default: 127.0.0.1)
#   LCC_PORT      — LM Studio port (default: 1234)
#   LLAMA_PORT    — llama.cpp server port (default: 8090)
#   LLAMA_DRAFT   — explicit path to a draft model for speculative decoding
#   LLAMA_SERVER  — path to llama-server binary
#   MODELS_DIR    — path to directory containing .gguf files

set -euo pipefail

LLAMA_SERVER="${LLAMA_SERVER:-${HOME}/git/llama.cpp/build/bin/llama-server}"
MODELS_DIR="${MODELS_DIR:-${HOME}/Models/gguf}"
LLAMA_PORT="${LLAMA_PORT:-8090}"

# --- Parse backend ---
BACKEND="lmstudio"
if [[ "${1:-}" == "--backend" ]]; then
  BACKEND="$2"
  shift 2
fi

pick_from_tty() {
  local prompt="$1"
  printf '%s' "$prompt" >&2
  read -r choice </dev/tty
  echo "${choice}"
}

# --- Backend: llama.cpp ---
if [[ "$BACKEND" == "llama" ]]; then
  if [[ ! -x "$LLAMA_SERVER" ]]; then
    echo "Error: llama-server not found at ${LLAMA_SERVER}" >&2
    echo "Set LLAMA_SERVER to the correct path." >&2
    exit 1
  fi

  # List GGUF models
  GGUF_FILES=()
  while IFS= read -r f; do
    GGUF_FILES+=("$f")
  done < <(find "$MODELS_DIR" -name "*.gguf" -type f | sort)

  if [[ ${#GGUF_FILES[@]} -eq 0 ]]; then
    echo "Error: no .gguf files found in ${MODELS_DIR}" >&2
    exit 1
  fi

  if [[ ${#GGUF_FILES[@]} -eq 1 ]]; then
    GGUF="${GGUF_FILES[0]}"
  else
    echo "Available GGUF models:" >&2
    for i in "${!GGUF_FILES[@]}"; do
      echo "  [$((i+1))] $(basename "${GGUF_FILES[$i]}")" >&2
    done
    choice=$(pick_from_tty "Choose [1]: ")
    choice="${choice:-1}"
    GGUF="${GGUF_FILES[$((choice-1))]}"
  fi

  MODEL_NAME=$(basename "$GGUF" .gguf)
  BASE_URL="http://127.0.0.1:${LLAMA_PORT}"

  # Stop any existing llama-server on the same port
  if curl -sf "${BASE_URL}/v1/models" > /dev/null 2>&1; then
    echo "llama-server already running on ${BASE_URL}, stopping..." >&2
    pkill -f "llama-server.*--port ${LLAMA_PORT}" 2>/dev/null || true
    sleep 1
  fi

  # Speculative decoding: find the smallest model from the same family as draft
  DRAFT_ARGS=()
  if [[ -n "${LLAMA_DRAFT:-}" ]]; then
    DRAFT_ARGS=(--model-draft "$LLAMA_DRAFT" --draft-max 16)
  else
    MODEL_FAMILY=$(basename "$GGUF" | sed -E 's/[-_]?[0-9]+[bB].*//i' | tr '[:upper:]' '[:lower:]')
    DRAFT=$(python3 -c "
import os, re, sys
gguf = '$GGUF'
family = '$MODEL_FAMILY'
candidates = []
for f in '''${GGUF_FILES[*]}'''.split():
    if f == gguf:
        continue
    name = os.path.basename(f).lower()
    f_family = re.sub(r'[-_]?[0-9]+\.?[0-9]*b.*', '', name, flags=re.I)
    if f_family != family:
        continue
    match = re.search(r'(\d+\.?\d*)b', name, re.I)
    if match:
        candidates.append((float(match.group(1)), f))
if candidates:
    candidates.sort(key=lambda x: x[0])
    print(candidates[0][1])
" 2>/dev/null)
    if [[ -n "$DRAFT" ]]; then
      echo "Draft model (speculative): $(basename "$DRAFT")" >&2
      DRAFT_ARGS=(--model-draft "$DRAFT" --draft-max 16)
    fi
  fi

  echo "Starting llama-server with: $(basename "$GGUF")" >&2
  "$LLAMA_SERVER" \
    --model "$GGUF" \
    ${DRAFT_ARGS[@]+"${DRAFT_ARGS[@]}"} \
    --port "$LLAMA_PORT" \
    --ctx-size 32768 \
    --n-gpu-layers 99 \
    > /tmp/llama-server.log 2>&1 &
  LLAMA_PID=$!

  # Kill llama-server when this script exits
  trap "kill $LLAMA_PID 2>/dev/null; wait $LLAMA_PID 2>/dev/null" EXIT

  # Wait for server to be ready
  echo "Waiting for server..." >&2
  for i in $(seq 1 30); do
    if curl -sf "${BASE_URL}/v1/models" > /dev/null 2>&1; then
      break
    fi
    if ! kill -0 "$LLAMA_PID" 2>/dev/null; then
      echo "Error: llama-server exited unexpectedly. Log:" >&2
      tail -20 /tmp/llama-server.log >&2
      exit 1
    fi
    sleep 1
  done

  if ! curl -sf "${BASE_URL}/v1/models" > /dev/null 2>&1; then
    echo "Error: llama-server did not respond after 30s. Log:" >&2
    tail -20 /tmp/llama-server.log >&2
    exit 1
  fi

  MODEL="$MODEL_NAME"
  echo "Model: $MODEL"
  echo "Server: ${BASE_URL} (llama.cpp, PID ${LLAMA_PID})"
  echo "---"

# --- Backend: LM Studio ---
elif [[ "$BACKEND" == "lmstudio" ]]; then
  LCC_HOST="${LCC_HOST:-127.0.0.1}"
  LCC_PORT="${LCC_PORT:-1234}"
  BASE_URL="http://${LCC_HOST}:${LCC_PORT}"

  if ! curl -sf "${BASE_URL}/v1/models" > /dev/null 2>&1; then
    echo "Error: LM Studio not responding at ${BASE_URL}" >&2
    echo "Make sure LM Studio is running with the server enabled." >&2
    exit 1
  fi

  MODELS_JSON=$(curl -sf "${BASE_URL}/v1/models")

  MODEL=$(python3 -c "
import json, sys
data = json.loads('''${MODELS_JSON}''')
models = [m for m in data.get('data', []) if not m['id'].startswith('text-embedding')]
if not models:
    sys.exit(1)
if len(models) == 1:
    print(models[0]['id'])
else:
    tty = open('/dev/tty', 'r')
    print('Available models:', file=sys.stderr)
    for i, m in enumerate(models):
        print(f'  [{i+1}] {m[\"id\"]}', file=sys.stderr)
    print('Choose [1]: ', end='', file=sys.stderr, flush=True)
    choice = tty.readline().strip() or '1'
    tty.close()
    print(models[int(choice)-1]['id'])
")

  if [[ -z "$MODEL" ]]; then
    echo "Error: no models loaded in LM Studio." >&2
    exit 1
  fi

  echo "Model: $MODEL"
  echo "Server: ${BASE_URL} (LM Studio)"
  echo "---"

else
  echo "Unknown backend: $BACKEND" >&2
  echo "Usage: local-claude [--backend lmstudio|llama]" >&2
  exit 1
fi

# --- Launch Claude Code ---
export ANTHROPIC_BASE_URL="${BASE_URL}"
export ANTHROPIC_API_KEY="local"
unset ANTHROPIC_AUTH_TOKEN 2>/dev/null || true
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Isolated config dir so it doesn't conflict with cloud claude.ai login
export CLAUDE_CONFIG_DIR="${HOME}/.claude-local"
mkdir -p "$CLAUDE_CONFIG_DIR"

if [[ -n "${LLAMA_PID:-}" ]]; then
  # Don't exec — keep bash alive so the EXIT trap can kill llama-server
  claude --model "$MODEL" "$@"
else
  exec claude --model "$MODEL" "$@"
fi
